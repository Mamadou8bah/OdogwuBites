# Copy to backend/.env and run npm commands from backend/.
# Use a separate development database only. Startup upserts default categories.
# Example local MongoDB URI; MongoDB must already be running locally.
MONGO_URI=mongodb://127.0.0.1:27017/odogwu_bites_dev

# Server: PORT defaults to 3000; localhost:4200 is already allowed by CORS.
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Authentication: generate a unique local secret before testing login.
JWT_SECRET=replace_with_a_unique_random_development_secret
SALT_ROUNDS=10

# Keep verification/reset links and verification redirects local.
PUBLIC_BACKEND_URL=http://localhost:3000
PUBLIC_FRONTEND_URL=http://localhost:4200

# Optional Resend: leave empty for local startup without email delivery.
# Delivery attempts fail explicitly when this is empty; accounts stay unverified.
RESEND_API_KEY=
# Optional sender; when unset, the code defaults to onboarding@resend.dev.
# RESEND_FROM=Developer <dev@example.test>

# Optional Cloudinary image uploads: use development credentials only.
CLOUD_NAME=
API_KEY=
API_SECRET=

# Optional ModemPay: leave empty to avoid initializing the payment client.
# Payment operations return HTTP 503 when this is empty; no wallet credit occurs.
# Do not exercise payment routes as part of setup.
MODEM_PAY_SECRET_KEY=

# Optional existing deployment aliases; leave unset for local development.
# Backend URL precedence: PUBLIC_BACKEND_URL, BACKEND_PUBLIC_URL,
# RENDER_EXTERNAL_URL, PUBLIC_URL, APP_PUBLIC_URL, request host, localhost.
# BACKEND_PUBLIC_URL=
# RENDER_EXTERNAL_URL=
# PUBLIC_URL=
# APP_PUBLIC_URL=

# Payment return URL precedence: PUBLIC_FRONTEND_URL, FRONTEND_PUBLIC_URL,
# FRONTEND_URL, VERCEL_URL (hostname only), request origin, localhost:4200.
# Verification redirect uses PUBLIC_FRONTEND_URL only, otherwise deployed login.
# FRONTEND_PUBLIC_URL=
# FRONTEND_URL=
# VERCEL_URL=
